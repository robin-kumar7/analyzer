# analyzer — environment file.
#
# This file is the single source of truth for the analyzer service.
# - Local dev:    set -a; source .env; set +a; ./build/analyzer serve
# - docker/podman compose: picked up automatically via env_file in compose.yaml.
#
# Hostnames here use localhost so local-host runs just work. compose.yaml
# overrides the networking URLs (kafka:9092, weaviate:8080, redis:6379,
# postgres:5432, host.containers.internal:11434) for in-network runs.

# ---- Core HTTP ----
PORT=8081
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=90s
HTTP_IDLE_TIMEOUT=60s
MAX_BODY_BYTES=1048576

# ---- Ollama (LLM + embeddings) ----
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=deepseek-r1:32b
# Per-request HTTP timeout for /api/generate. 32B reasoning models on
# CPU/Metal commonly take 60-300s. Bump to 900s+ on slow hardware or
# switch OLLAMA_MODEL to a smaller one for ~10-30s.
OLLAMA_TIMEOUT=600s
EMBED_MODEL=nomic-embed-text
EMBED_TIMEOUT=30s

# ---- Weaviate ----
WEAVIATE_URL=http://localhost:8080
WEAVIATE_CLASS=RepoChunk
WEAVIATE_TIMEOUT=15s

# ---- Retrieval ----
DEFAULT_TOP_K=8
HYBRID_ALPHA=0.65

# ---- Multi-repo resolution ----
RESOLVE_REPO_MIN_SCORE=1.0
RESOLVE_REPO_AMBIGUITY=0.90

# ---- Grounding ----
ANCHOR_LEN=6
ANCHOR_MIN=2

# ---- Auth & rate limit ----
API_KEY=
RATE_LIMIT_RPS=5
RATE_LIMIT_BURST=10

# ---- Logging ----
LOG_LEVEL=info
LOG_FORMAT=json

# ---- Redis (summary cache; empty disables) ----
REDIS_URL=redis://localhost:6379/0

# ---- Doc-priming / service-summary cache ----
SUMMARY_ENABLED=true
DOCS_PATH_PREFIX=site/
SUMMARY_REDIS_KEY_PREFIX=analyzer:summary:
SUMMARY_TTL=24h
SUMMARY_MAX_DOC_CHUNKS=30
SUMMARY_MAX_TOKENS=4096

# ---- Intelligence enrichment ----
INTELLIGENCE_ENABLED=true
SYMBOL_LOOKUP_LIMIT=10
FUNCTION_SEARCH_LIMIT=10
CALLGRAPH_DEPTH=2
CALLGRAPH_MAX_EDGES=20
REPOMAP_LIMIT=20
MAX_CONTEXT_TOKENS=50000

# ---- Kafka ingestion ----
# Auto-enabled when KAFKA_BROKERS is non-empty. Set KAFKA_ENABLED=false to
# force-disable. Leave KAFKA_OUTPUT_TOPIC empty to disable publishing.
#
# Publish filter is per-service, sourced from Postgres
# service_mappings.notify_min_severity / notify_min_confidence. Edit
# those per-row (via the analytics-ui Service Registry) to control
# which Issues are forwarded to the notifier — there is no global
# env-driven override.
KAFKA_ENABLED=
KAFKA_BROKERS=localhost:19092
KAFKA_CLIENT_ID=analyzer
KAFKA_GROUP_ID=analyzer
KAFKA_INPUT_TOPIC=logs.enriched
KAFKA_OUTPUT_TOPIC=teams-notifier
KAFKA_WORKERS=1
KAFKA_BATCH_SIZE=1
KAFKA_BATCH_TIMEOUT=30s
KAFKA_SESSION_TIMEOUT=5m
KAFKA_ANALYZE_TIMEOUT=5m
KAFKA_PUBLISH_TIMEOUT=10s
KAFKA_SHUTDOWN_TIMEOUT=30s

# ---- Analytics persistence (Postgres) ----
# Empty = persistence disabled. Set = required at boot (fatal on connect fail).
ANALYTICS_DB_URL=postgres://analyzer:analyzer@localhost:5432/analytics?sslmode=disable
ANALYTICS_DB_TIMEOUT=10s
ANALYTICS_DB_MAX_CONNS=10
ISSUE_RETENTION_DAYS=90
ISSUE_RETENTION_PRUNE_INTERVAL=1h

# ---- Service registry (service_mappings table → weaviate repo) ----
# Kafka consumer resolves the inbound service identity to its Weaviate
# repo via the analytics-DB service_mappings table; lookups are cached in
# Redis with separate TTLs for hits and misses. See docs/10-service-registry.md.
SERVICE_MAPPER_TTL=60s
SERVICE_MAPPER_NEG_TTL=30s

# ---- Notification deduplication ----
# Minimum time between Teams notifications for the same bug
# (same file + line + service + category). After this window expires
# the bug is eligible to be reported again.
# Set to 0 to disable. Default: 1h
NOTIFY_COOLDOWN=1h

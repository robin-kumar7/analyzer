# analyzer service — example environment file
# Copy to `analyzer.env` (or export directly) and adjust as needed.
# All values below are the built-in defaults from internal/config/config.go.
#
# Usage:
#   cp analyzer.example.env analyzer.env
#   set -a; source analyzer.env; set +a
#   ./build/analyzer serve

# ---- Core HTTP ----
PORT=8081
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=90s
HTTP_IDLE_TIMEOUT=60s
MAX_BODY_BYTES=1048576

# ---- Ollama (LLM + embeddings) ----
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=deepseek-r1:32b
OLLAMA_TIMEOUT=180s
EMBED_MODEL=nomic-embed-text:latest
EMBED_TIMEOUT=30s

# ---- Weaviate (read-only; populated by repo-indexer) ----
WEAVIATE_URL=http://localhost:8080
WEAVIATE_CLASS=RepoChunk
WEAVIATE_TIMEOUT=15s

# ---- Retrieval ----
DEFAULT_TOP_K=8
HYBRID_ALPHA=0.65

# ---- Multi-repo resolution (FR-A5b) ----
RESOLVE_REPO_MIN_SCORE=1.0
RESOLVE_REPO_AMBIGUITY=0.90

# ---- Grounding (B1) ----
ANCHOR_LEN=6
ANCHOR_MIN=2

# ---- Auth & rate limit ----
# Leave API_KEY empty to disable bearer-token auth.
API_KEY=
RATE_LIMIT_RPS=5
RATE_LIMIT_BURST=10

# ---- Logging ----
# LOG_LEVEL: debug|info|warn|error
# LOG_FORMAT: json|text
LOG_LEVEL=info
LOG_FORMAT=json

# ---- Redis (summary cache; set empty to disable) ----
REDIS_URL=redis://localhost:6379/0

# ---- Doc-priming / service-summary cache (§7a) ----
SUMMARY_ENABLED=true
DOCS_PATH_PREFIX=site/
SUMMARY_REDIS_KEY_PREFIX=analyzer:summary:
SUMMARY_TTL=24h
SUMMARY_MAX_DOC_CHUNKS=30
SUMMARY_MAX_TOKENS=4096

# ---- Intelligence enrichment (repo-indexer v2) ----
INTELLIGENCE_ENABLED=true
SYMBOL_LOOKUP_LIMIT=10
FUNCTION_SEARCH_LIMIT=10
CALLGRAPH_DEPTH=2
CALLGRAPH_MAX_EDGES=20
REPOMAP_LIMIT=20
MAX_CONTEXT_TOKENS=50000

# ---- Kafka ingestion (consume log-shipper records, publish Issues) ----
# Auto-enabled when KAFKA_BROKERS is non-empty. Set KAFKA_ENABLED=false to
# force-disable even when brokers are set. Leave KAFKA_OUTPUT_TOPIC empty to
# disable publishing (the analyzer will still consume and log results).
KAFKA_ENABLED=
KAFKA_BROKERS=localhost:19092
KAFKA_CLIENT_ID=analyzer
KAFKA_GROUP_ID=analyzer
KAFKA_INPUT_TOPIC=logs.enriched
KAFKA_OUTPUT_TOPIC=teams-notifier
KAFKA_WORKERS=1
# Batch N input log records into a single analyzer call (one Issue per batch).
KAFKA_BATCH_SIZE=1
# Max time to wait for a partial batch to fill before flushing it anyway.
KAFKA_BATCH_TIMEOUT=30s
KAFKA_SESSION_TIMEOUT=5m
KAFKA_ANALYZE_TIMEOUT=5m
KAFKA_PUBLISH_TIMEOUT=10s
KAFKA_SHUTDOWN_TIMEOUT=30s

# Publish filter is per-service, sourced from Postgres
# service_mappings.notify_min_severity / notify_min_confidence.
# Edit rows in the analytics-ui Service Registry to gate which
# Issues are forwarded to the notifier — no env override.

# ---------------------------------------------------------------------
# Analytics persistence (FR-A8).
# When ANALYTICS_DB_URL is set the analyzer persists every analyzed
# Issue (Kafka and HTTP paths) into Postgres for the analytics-api
# dashboard service. Leave empty to disable persistence; the analysis
# pipeline keeps running either way.
# ---------------------------------------------------------------------
# Postgres DSN. Example: postgres://analyzer:secret@postgres:5432/analytics?sslmode=disable
ANALYTICS_DB_URL=postgres://analyzer:analyzer@localhost:5432/analytics?sslmode=disable
# Per-query timeout for INSERTs, pings, and pruner deletes.
ANALYTICS_DB_TIMEOUT=10s
# Max pool size. Tune to AnalyzeWorkers + headroom for the pruner.
ANALYTICS_DB_MAX_CONNS=10
# Retention window in days. 0 = keep forever.
ISSUE_RETENTION_DAYS=90
# How often the pruner runs.
ISSUE_RETENTION_PRUNE_INTERVAL=1h
